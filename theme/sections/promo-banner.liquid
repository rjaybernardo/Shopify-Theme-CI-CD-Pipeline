<section class="promo" aria-labelledby="PromoHeading-{{ section.id }}">
  <p class="eyebrow">{{ 'general.eyebrow' | t }}</p>
  <h1 id="PromoHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
  <p>{{ section.settings.description | escape }}</p>
  {% if section.settings.link != blank %}
    <a class="button" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
  {% endif %}
</section>

{% schema %}
{
  "name": "Promotional banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thoughtful essentials. Everyday comfort." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Discover a considered collection, made for the way you live." },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Explore the collection" }
  ],
  "presets": [{ "name": "Promotional banner" }]
}
{% endschema %}
